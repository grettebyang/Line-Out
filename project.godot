config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DogSledRunner"
run/main_scene="uid://hic4uwagu2f7"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[audio]

buses/default_bus_layout="uid://drn7pg6phx4j2"

[autoload]

InputSystem="*res://Production/Components/InputSystem/InputSystem.tscn"
PlayerCursorContainer="*uid://dvgm6831k4g24"
RhythmManager="*res://Production/Components/Rhythm/RhythmManager.tscn"
TimeManager="*res://prototype/James/scripts/TimeManager.tscn"
GameManager="*res://Production/Components/GameManagers/GameManager.tscn"
DatabaseRoot="*res://Production/Components/Databases/DatabaseRoot.tscn"
NetworkManager="*res://Production/Components/Multiplayer/NetworkManager.cs"
LoadingScreen="*res://Production/Components/UI/Prefabs/LoadingScreen/LoadingScreen.tscn"
SaveScoreDialog="*res://Production/Components/UI/Prefabs/PopupDialogs/SaveScoreDialog.tscn"
PopupBase="*res://Production/Components/UI/Prefabs/PopupDialogs/PopupBase.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DogSledRunner"

[editor_plugins]

enabled=PackedStringArray()

