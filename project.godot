3d_physics/layer_2="Sled"
3d_physics/layer_3="Dog"
3d_physics/layer_4="Enemy"
2d_physics/layer_5="Disabled"
3d_physics/layer_5="PowerUp"
3d_physics/layer_6="Penguin"
2d_physics/layer_9="Traps and hazards"
3d_physics/layer_9="Traps"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

